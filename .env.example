# GitHub Actions에서는 이 내용을 비밀값 ENV_FILE에 그대로 넣는다

# ── Discord ──────────────────────────────────────────
DISCORD_BOT_TOKEN=
# 목적지별 채널 ID (config/destinations.json의 channel_env 이름)
TECH_NEWS_CHANNEL=

# ── LLM ──────────────────────────────────────────────
# Google AI Studio에서 발급한 Gemini API 키 (한국어 제목·요약, 개발 무관 글 거르기)
GEMINI_API_KEY=
